if theme.fancybox == true
  script(type='text/javascript', src=url_for('lib/fancybox/jquery.fancybox.min.js'), async)
  script(type='text/javascript', src=url_for(theme.js) + '/fancybox.js' + '?v=' + theme.version, async)
  link(rel='stylesheet', type='text/css', href=url_for('lib/fancybox/jquery.fancybox.min.css'))

if theme.copycode == true
  script(type='text/javascript', src=url_for('lib/clipboard/clipboard.min.js'))
  script(type='text/javascript', src=url_for('lib/toastr/toastr.min.js'))
  link(rel='stylesheet', href=url_for('lib/toastr/toastr.min.css'))
  script(type='text/javascript', src=url_for(theme.js) + '/copycode.js', successtext=__('copy_success_text'))
  link(rel='stylesheet', type='text/css', href=url_for(theme.css) + '/copycode.css')

script(type='text/javascript', src=url_for(theme.js) + '/codeblock-resizer.js' + '?v=' + theme.version)
script(type='text/javascript', src=url_for(theme.js) + '/smartresize.js' + '?v=' + theme.version)

if config.feed
  script(type='text/javascript', src=url_for(theme.js) + '/rss-copy.js' + '?v=' + theme.version)

if theme.cf_stats && theme.cf_stats.endpoint
  include cf_stats.pug
