head
    meta(http-equiv='content-type', content='text/html; charset=utf-8')
    meta(content='width=device-width, initial-scale=1.0', name='viewport')
    meta(content='yes', name='apple-mobile-web-app-capable')
    meta(content='black-translucent', name='apple-mobile-web-app-status-bar-style')
    meta(content='telephone=no', name='format-detection')
    block title
    - var seo = theme.seo || {}
    - var seo_cover = seo_image()
    != open_graph({title: seo_title() || config.title, description: seo_description(), url: seo_canonical(), image: seo_cover || full_url_for('apple-touch-icon.png'), twitter_card: seo_cover ? 'summary_large_image' : 'summary', language: 'zh-CN', twitter_id: seo.twitter_id})
    link(rel='canonical', href=seo_canonical())
    if seo_markdown_url()
      link(rel='alternate', type='text/markdown', href=seo_markdown_url(), title='Markdown')
    != seo_json_ld()
    if seo.google_site_verification
      meta(name='google-site-verification', content=seo.google_site_verification)
    if seo.baidu_site_verification
      meta(name='baidu-site-verification', content=seo.baidu_site_verification)
    if seo.bing_site_verification
      meta(name='msvalidate.01', content=seo.bing_site_verification)
    link(rel='stylesheet', type='text/css', href=url_for(theme.css) + '/style.css' + '?v=' + theme.version)
    //- 第三方库固定版本并放在本站（themes/maupassant/source/lib），不依赖外部 CDN
    link(rel='stylesheet', type='text/css', href=url_for('lib/normalize/normalize.css'))
    link(rel='stylesheet', type='text/css', href=url_for('lib/purecss/pure-min.css'))
    link(rel='stylesheet', type='text/css', href=url_for('lib/purecss/grids-responsive-min.css'))
    link(rel='stylesheet', href=url_for('lib/font-awesome/css/font-awesome.min.css'))
    script(type='text/javascript', src=url_for('lib/jquery/jquery.min.js'))
    link(rel='icon', sizes='any', href=url_for('favicon.ico'))
    link(rel='apple-touch-icon', href=url_for('apple-touch-icon.png'))
    if config.feed
      link(rel='alternate', type=feed_type, href=url_for(config.feed.path), title=config.title)
