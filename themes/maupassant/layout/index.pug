extends base

block title
  - var page_suffix = page.current > 1 ? ' | 第 ' + page.current + ' 页' : ''
  if config.subtitle
    title= config.title + ' | ' + config.subtitle + page_suffix
  else
    title= config.title + page_suffix

block content
  for post in page.posts.toArray()
    .post
      h2.post-title
        include _partial/helpers.pug
        a(href=url_for(post.path))
          +title(post)
      .post-meta= post.date.format(config.date_format)
      if post.description
        .post-content
          != post.description
      else if post.excerpt
        .post-content
          != post.excerpt
      else if post.content
        - var br = 0
        - for (var i = 0; i < 5; ++i) {
          - br = post.content.indexOf('\n',br+1)
          if br<0
            - break
          if br >150
            - break
        - }
        if br < 0
          .post-content
            != post.content
        else
          .post-content
            != post.content.substring(0, br)
      p(class='readmore')
        a(href=url_for(post.path))= __('更多')

  include _partial/paginator.pug
